    "db:reset-demo": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
