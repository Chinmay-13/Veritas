{
  "name": "veritas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "DATABASE_URL=pglite://memory SESSION_SECRET=local-dev-secret-change-me-32-chars-min next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
