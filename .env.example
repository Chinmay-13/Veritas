# Postgres connection string from Neon (https://neon.tech, free tier). Use the *pooled* connection string.
# For a zero-setup local run you can instead use:  DATABASE_URL=pglite://memory
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign the session cookie. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters
